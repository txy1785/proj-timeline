DB_URL=jdbc:mysql://127.0.0.1:3306/proj_timeline?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=proj_timeline
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_TIME_ZONE=Asia/Shanghai
SERVER_PORT=8080

# Only used with --app.bootstrap-admin=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=

# Docker Compose only
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
HTTP_PORT=80

# 文档上传（本地磁盘存储）
UPLOAD_ROOT=./data/files
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=60MB

